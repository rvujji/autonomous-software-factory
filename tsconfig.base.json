{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,

    "declaration": true,

    "declarationMap": true,

    "sourceMap": true,

    "noUncheckedIndexedAccess": true,

    "exactOptionalPropertyTypes": true,

    "noImplicitOverride": true,

    "noFallthroughCasesInSwitch": true,

    "esModuleInterop": true,

    "skipLibCheck": true,

    "resolveJsonModule": true,

    "types": ["node"]
  }
}