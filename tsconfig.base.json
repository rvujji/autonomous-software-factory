{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,

    "declaration": true,

    "declarationMap": true,

    "sourceMap": true,

    "noUncheckedIndexedAccess": true,

    "exactOptionalPropertyTypes": true,

    "noImplicitOverride": true,

    "noFallthroughCasesInSwitch": true,

    "esModuleInterop": true,

    "skipLibCheck": true,

    "resolveJsonModule": true,

    "types": ["node"],

    "baseUrl": ".",

    "paths": {
      "@engineering/shared": ["./shared/src/index.ts"],
      "@engineering/shared/*": ["./shared/src/*"],

      "@engineering/core": ["./core/src/index.ts"],
      "@engineering/core/*": ["./core/src/*"],

      "@engineering/platform": ["./platform/src/index.ts"],
      "@engineering/platform/*": ["./platform/src/*"],

      "@engineering/engineering-pack": ["./engine-packs/engineering/src/index.ts"],
      "@engineering/engineering-pack/*": ["./engine-packs/engineering/src/*"],

      "@engineering/backends/cli": ["./backends/cli/src/index.ts"],
      "@engineering/backends/cli/*": ["./backends/cli/src/*"],

      "@engineering/backends/opencode": ["./backends/opencode/src/index.ts"],
      "@engineering/backends/opencode/*": ["./backends/opencode/src/*"],

      "@engineering/backends/shared": ["./backends/shared/src/index.ts"],
      "@engineering/backends/shared/*": ["./backends/shared/src/*"],

      
    }
  }
}