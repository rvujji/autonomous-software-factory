      "priority": "CRITICAL",
      "status": "DRAFT",
      "acceptanceCriteria": [
        {
          "id": "NAC-009-1",
          "description": "Failed transactions leave storage in its prior state."
        },
        {
          "id": "NAC-009-2",
          "description": "No partial writes occur under any failure condition."
        }
      ]
    },
    {
      "id": "NFR-010",
      "title": "Logging Independence from Execution",
