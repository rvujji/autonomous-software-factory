        {
          "id": "NAC-010-2",
          "description": "Log entries are immutable once created."
        }
      ]
    },
    {
      "id": "NFR-011",
      "title": "Minimal Runtime Overhead",
      "description": "Engine resolution shall be deterministic. Engine invocation overhead shall remain minimal. Pipeline validation shall execute once per execution. CLI startup shall introduce minimal overhead.",
